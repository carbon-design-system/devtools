{
  "name": "@carbon/devtools-component-list",
  "version": "2.8.4",
  "description": "Generates a list of components and their selectors across all of the Carbon libraries.",
  "main": "./dist/index.json",
  "scripts": {
    "start": "yarn watch",
    "bundle": "webpack --config webpack.js",
    "bundle:watch": "webpack --watch --config webpack.js",
    "build": "yarn bundle && node index.js",
    "build:watch": "nodemon --watch dist/index.js --watch index.js --ignore dist/index.json --ignore src",
    "clean": "rimraf dist && rimraf node_modules",
    "format": "prettier --write '*.{js,json,md,scss,ts}' '**/*.{js,json,md,scss,ts}' '!**/{dist,build,es,lib,storybook,ts,umd}/**' '!**/*.{jpg,jpeg,gif,png}'",
    "format:diff": "prettier --list-different '*.{js,json,md,scss,ts}' '**/*.{js,json,md,scss,ts}' '!**/{dist,build,es,lib,storybook,ts,umd}/**' '!**/*.{jpg,jpeg,gif,png}'",
    "lint": "yarn lint:js",
    "lint:js": "eslint src/",
    "test": "yarn format && yarn lint"
  },
  "dependencies": {
    "@carbon/colors": "^10.37.5",
    "@carbon/ibm-products": "^1.73.6",
    "@carbon/ibm-security": "^1.47.0",
    "@carbon/ibmdotcom-react": "^1.66.1",
    "@carbon/ibmdotcom-web-components": "^1.51.1",
    "@carbon/icons-react": "^10.49.6",
    "@carbon/import-once": "^10.7.2",
    "@carbon/layout": "^10.37.5",
    "@carbon/motion": "^10.29.5",
    "@carbon/themes": "^10.55.6",
    "@carbon/type": "^10.45.6",
    "carbon-components": "^10.59.2",
    "carbon-components-react": "^7.60.5",
    "carbon-icons": "^7.0.7",
    "carbon-web-components": "^1.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/react": "^12.1.5",
    "@types/react": "^17.0.92",
    "babel-loader": "^9.2.1",
    "babel-preset-carbon": "^0.0.14",
    "cheerio": "1.0.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "eslint": "^9.39.4",
    "eslint-config-carbon": "^3.25.0",
    "global": "^4.4.0",
    "jsdom": "^24.0.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "rimraf": "^6.0.1",
    "sass": "1.77.8",
    "stylelint": "^15.0.0",
    "stylelint-config-carbon": "1.17.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-carbon"
    ],
    "rules": {
      "max-nesting-depth": 3
    }
  },
  "private": true,
  "sideEffects": false,
  "keywords": [
    "IBM",
    "Dotcom",
    "IBM.com",
    "Carbon",
    "Tools",
    "Development"
  ],
  "author": "IBM",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/devtools"
  },
  "bugs": {
    "url": "https://github.com/carbon-design-system/devtools/issues/new",
    "email": "carbon@us.ibm.com"
  },
  "homepage": "https://github.com/carbon-design-system/devtools#readme"
}
